{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowExternalDNSOnlyForSpecificZone",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/Z01888861IIFECUO0AVEP"
      ]
    },
    {
      "Sid": "AllowExternalDNSToListResources",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource"
      ],
      "Resource": [
        "*"
      ]
    }
  ]     
}
